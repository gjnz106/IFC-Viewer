rules_version = '2';

// IFC Delta — Cloud Projects (Phase 12) / IFC file storage (Phase 13),
// extended with per-project roles.
// ACL reads from the Firestore `projects/{projectId}` doc (memberEmails +
// memberRoles) so Storage and Firestore never drift out of sync with two
// separate ACLs. Role semantics mirror firestore.rules exactly — see that
// file's header comment for why a forged 'owner' entry in memberRoles is
// inert (ownership is defined solely by the ownerEmail field, never read
// from here).
service firebase.storage {
  match /b/{bucket}/o {

    // Access is restricted to admin-provisioned accounts: the signed-in email
    // must have a matching doc in Firestore `allowedUsers/{email}` (managed by
    // the admin in the console). Mirrors firestore.rules' isAllowed() so the
    // two services share one gate. Email verification is not used.
    function isAllowed() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/allowedUsers/$(request.auth.token.email.lower()));
    }

    function projectDoc(projectId) {
      return firestore.get(/databases/(default)/documents/projects/$(projectId)).data;
    }

    function isProjectMember(projectId) {
      let proj = projectDoc(projectId);
      // Lowercased to match how the client normalizes/stores memberEmails.
      return proj.memberEmails is list
        && request.auth.token.email.lower() in proj.memberEmails;
    }

    function storedRole(data, e) {
      return data.get('memberRoles', {}).get(e, null);
    }
    function roleOf(data, e) {
      return e == data.ownerEmail
        ? 'owner'
        : (
            (storedRole(data, e) != null && storedRole(data, e) != 'owner')
              ? storedRole(data, e)
              : (data.memberEmails is list && e in data.memberEmails ? 'editor' : null)
          );
    }
    function roleRank(role) {
      return role == 'owner' ? 3 : role == 'admin' ? 2 : role == 'editor' ? 1 : role == 'viewer' ? 0 : -1;
    }

    // A viewer may read/download files but never upload, overwrite, or
    // delete one — this is the storage-side half of the editor+ floor
    // firestore.rules enforces on the parent project's files/{fileId} docs.
    function canEditProject(projectId) {
      return roleRank(roleOf(projectDoc(projectId), request.auth.token.email.lower())) >= roleRank('editor');
    }

    // Reasonable IFC-related content types — browsers send inconsistent
    // contentType for .ifc uploads (often application/octet-stream), so we
    // allow-list broadly rather than hard-fail legitimate uploads.
    function isAllowedIfcContentType() {
      return request.resource.contentType in [
        'application/octet-stream',
        'application/x-step',
        'application/ifc',
        'text/plain',
        'application/vnd.ifc',
        // Compare/Clash result JSON (Phase 15) — same path pattern
        // (projects/{projectId}/{allPaths=**}) already covers results/*.json.
        'application/json',
      ];
    }

    match /projects/{projectId}/{allPaths=**} {
      allow read: if isAllowed() && isProjectMember(projectId);

      // Split from a single `allow write`: on delete `request.resource` is
      // null, so the size/contentType checks error out and every
      // deleteObject() was denied — orphaned blobs accrued forever.
      allow create, update: if isAllowed()
        && canEditProject(projectId)
        && request.resource.size < 500 * 1024 * 1024
        && isAllowedIfcContentType();

      allow delete: if isAllowed() && canEditProject(projectId);
    }
  }
}
