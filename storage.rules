rules_version = '2';

// IFC Delta — Cloud Projects (Phase 12) / IFC file storage (Phase 13).
// ACL reads from the Firestore `projects/{projectId}` doc (memberEmails)
// so Storage and Firestore never drift out of sync with two separate ACLs.
//
// DELIBERATELY membership-only, NOT role-aware — do not "fix" this to match
// firestore.rules without testing it against real Firebase first.
//
// A role-gated version of this file (viewer = read-only, editor+ = write)
// shipped and broke ALL uploads for every role including owner: Storage
// Rules is a different dialect from Firestore Rules, and the `memberRoles`
// lookup used `Map.get(key, default)` — valid in Firestore Rules, evidently
// not in Storage Rules, and a rules evaluation error denies the request.
// It could not be caught locally: the Storage emulator's cross-service
// `firestore.get()/exists()` does not work under
// @firebase/rules-unit-testing here — even THIS known-good file fails every
// check there, so an emulator pass proves nothing about this file either way.
//
// The role restriction is not lost, only moved: firestore.rules gates the
// `projects/{id}/files/{fileId}` metadata doc at editor+, and that IS
// emulator-verified. A viewer who forced a raw blob upload would produce an
// orphan the app never lists. The remaining gap versus firestore.rules is
// blob delete, which any member can still do — the same behaviour this app
// has always had, not a regression introduced by the roles work.
service firebase.storage {
  match /b/{bucket}/o {

    // Access is restricted to admin-provisioned accounts: the signed-in email
    // must have a matching doc in Firestore `allowedUsers/{email}` (managed by
    // the admin in the console). Mirrors firestore.rules' isAllowed() so the
    // two services share one gate. Email verification is not used.
    function isAllowed() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/allowedUsers/$(request.auth.token.email.lower()));
    }

    function isProjectMember(projectId) {
      let proj = firestore.get(/databases/(default)/documents/projects/$(projectId));
      // Lowercased to match how the client normalizes/stores memberEmails.
      return proj.data.memberEmails is list
        && request.auth.token.email.lower() in proj.data.memberEmails;
    }

    // Reasonable IFC-related content types — browsers send inconsistent
    // contentType for .ifc uploads (often application/octet-stream), so we
    // allow-list broadly rather than hard-fail legitimate uploads.
    function isAllowedIfcContentType() {
      return request.resource.contentType in [
        'application/octet-stream',
        'application/x-step',
        'application/ifc',
        'text/plain',
        'application/vnd.ifc',
        // Compare/Clash result JSON (Phase 15) — same path pattern
        // (projects/{projectId}/{allPaths=**}) already covers results/*.json.
        'application/json',
      ];
    }

    match /projects/{projectId}/{allPaths=**} {
      allow read: if isAllowed() && isProjectMember(projectId);

      // Split from a single `allow write`: on delete `request.resource` is
      // null, so the size/contentType checks error out and every
      // deleteObject() was denied — orphaned blobs accrued forever.
      allow create, update: if isAllowed()
        && isProjectMember(projectId)
        && request.resource.size < 500 * 1024 * 1024
        && isAllowedIfcContentType();

      allow delete: if isAllowed() && isProjectMember(projectId);
    }
  }
}
