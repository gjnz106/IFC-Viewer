rules_version = '2';

// IFC Delta — Cloud Projects (Phase 12), extended with per-project roles.
// Single source of truth for membership: `projects/{projectId}.memberEmails`
// (always includes ownerEmail — see frontend/src/lib/cloud-projects.ts's
// normalizeMemberEmails). Storage rules cross-reference this same doc so
// there is exactly one ACL to keep correct.
//
// Roles (frontend/src/lib/cloud-projects.ts's ProjectRole, least → most
// privileged): viewer < editor < admin < owner. Stored in
// `projects/{projectId}.memberRoles`, keyed by lower-cased email. Ownership
// itself is NEVER read from memberRoles — it is defined solely by the
// `ownerEmail` field, which this file makes immutable on update (see
// `allow update` below). That means a forged 'owner' entry in memberRoles
// for anyone other than ownerEmail is inert: roleOf() below ignores it and
// falls back to the member-default 'editor', so there is no privilege-
// escalation path through that field even for a hand-crafted write.
service cloud.firestore {
  match /databases/{database}/documents {

    // Access is restricted to admin-provisioned accounts: the signed-in
    // email must have a matching doc in `allowedUsers/{email}` (managed by
    // the admin in the Firebase console). Email verification is not used —
    // there is no self-serve signup, and a stranger who self-registers via
    // the Auth API has no allowlist doc, so every rule below denies them.
    // rules' get()/exists() are privileged reads, so the allowlist collection
    // itself can stay locked to clients (see the allowedUsers match block).
    function isAllowed() {
      return request.auth != null
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower()));
    }

    // Admin = an allowed user whose allowedUsers/{email} doc has `admin: true`
    // (set by the site admin in the Firebase console). This is the APP-WIDE
    // flag — distinct from the per-project 'admin' role in memberRoles below.
    // Only app-wide admins may CREATE cloud projects; members can still
    // read/update the ones they're shared into per their per-project role.
    // get().data.get(key, default) tolerates docs without the field.
    function isAdmin() {
      return isAllowed()
        && get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower())).data.get('admin', false) == true;
    }

    // Lowercased to match how the client normalizes/stores memberEmails
    // (cloud-projects.ts's normEmail) — a raw-case mismatch here would
    // make Firestore reject the whole query, not just deny matching docs.
    function email() {
      return request.auth.token.email.lower();
    }

    // No `data.memberEmails is list` type-guard here on purpose: Firestore
    // can't statically prove an `array-contains` LIST query satisfies a rule
    // that type-checks the field first, and rejects the whole query with
    // permission-denied (confirmed via the Firestore emulator) — memberEmails
    // is always written as an array by the client, so the guard is
    // redundant for reads. Writes keep the stricter check (see
    // memberEmailsIncludeOwner) since single-document writes aren't subject
    // to this list-query limitation.
    function isMember(data) {
      return email() in data.memberEmails;
    }

    function memberEmailsIncludeOwner(data) {
      return data.ownerEmail is string
        && data.memberEmails is list
        && data.ownerEmail in data.memberEmails;
    }

    // See the file-level comment for why a non-owner's stored 'owner' value
    // is ignored rather than trusted. Mirrors
    // frontend/src/lib/cloud-projects.ts's roleOf() exactly.
    //
    // These helpers are Firestore-Rules-only. storage.rules deliberately does
    // NOT mirror them — `Map.get(key, default)` below is not valid in the
    // Storage Rules dialect and denied every upload when it was tried. See
    // storage.rules' header before attempting to share this logic.
    function storedRole(data, e) {
      return data.get('memberRoles', {}).get(e, null);
    }
    function roleOf(data, e) {
      return e == data.ownerEmail
        ? 'owner'
        : (
            (storedRole(data, e) != null && storedRole(data, e) != 'owner')
              ? storedRole(data, e)
              : (e in data.memberEmails ? 'editor' : null)
          );
    }
    function roleRank(role) {
      return role == 'owner' ? 3 : role == 'admin' ? 2 : role == 'editor' ? 1 : role == 'viewer' ? 0 : -1;
    }
    function roleAtLeast(data, e, min) {
      return roleRank(roleOf(data, e)) >= roleRank(min);
    }

    // Admin-managed allowlist: one doc per permitted account, id = the
    // lowercased email. Created/edited by the admin in the Firebase console
    // (client writes are denied). A user may read only their own doc, which
    // the app's sign-in gate uses to decide access — so nobody can enumerate
    // who else is allowed. (isAllowed()'s exists() is a privileged rules read
    // and works regardless of these client rules.)
    match /allowedUsers/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    // Manpower Planning app (separate hosting site, same project). Its data is
    // shared across the whole team — the same allowlist gate as everything
    // else, no per-project membership. Collections are prefixed `manpower_` so
    // they never collide with IFC Delta's own `projects/*` above.
    match /manpower_projects/{docId} {
      allow read, write: if isAllowed();
    }
    match /manpower_groups/{docId} {
      allow read, write: if isAllowed();
    }
    match /manpower_positions/{docId} {
      allow read, write: if isAllowed();
    }

    match /projects/{projectId} {
      // Any role — including viewer — may read.
      allow read: if isAllowed() && isMember(resource.data);

      // Creation is app-admin-only (members can still be shared into existing
      // projects and read/update them per their per-project role).
      allow create: if isAdmin()
        && request.resource.data.ownerEmail == email()
        && memberEmailsIncludeOwner(request.resource.data)
        && isMember(request.resource.data);

      allow update: if isAllowed()
        && isMember(resource.data)
        && memberEmailsIncludeOwner(request.resource.data)
        // Ownership can't be handed off by a plain update (no transfer UI
        // yet) — this is also what makes a forged 'owner' value in
        // memberRoles harmless (see roleOf's comment above).
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        // Changing membership (memberEmails) or roles (memberRoles) requires
        // admin+ — anyone below that could otherwise add/remove members or
        // grant themselves a higher role via the same field.
        && (
          (request.resource.data.memberEmails == resource.data.memberEmails
              && request.resource.data.get('memberRoles', {}) == resource.data.get('memberRoles', {}))
          || roleAtLeast(resource.data, email(), 'admin')
        )
        // Floor for ANY update, membership or not: a viewer may read but
        // never write, including a plain rename/settings change.
        && roleAtLeast(resource.data, email(), 'editor');

      // Owner-only: any member deleting the shared project (plus every
      // teammate's files) is too destructive to leave open even to admins.
      allow delete: if isAllowed() && email() == resource.data.ownerEmail;

      match /files/{fileId} {
        allow read: if isAllowed()
          && isMember(get(/databases/$(database)/documents/projects/$(projectId)).data);
        // Uploading/editing/deleting a file is content, not membership — same
        // editor+ floor as the parent project doc's non-membership fields.
        allow write: if isAllowed()
          && roleAtLeast(get(/databases/$(database)/documents/projects/$(projectId)).data, email(), 'editor');
      }

      // Phase 15: saved Compare/Clash result metadata. Firestore rules don't
      // cascade into subcollections, so this needs its own block — without it
      // the default deny made saveResult()'s metadata write and
      // fetchResultMetadata()'s read both fail, so restore never fired.
      match /results/{resultId} {
        allow read: if isAllowed()
          && isMember(get(/databases/$(database)/documents/projects/$(projectId)).data);
        allow write: if isAllowed()
          && roleAtLeast(get(/databases/$(database)/documents/projects/$(projectId)).data, email(), 'editor');
      }
    }
  }
}
