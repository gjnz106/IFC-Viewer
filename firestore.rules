rules_version = '2';

// IFC Delta — Cloud Projects (Phase 12).
// Single source of truth for membership: `projects/{projectId}.memberEmails`
// (always includes ownerEmail — see frontend/src/lib/cloud-projects.ts's
// normalizeMemberEmails). Storage rules cross-reference this same doc so
// there is exactly one ACL to keep correct.
service cloud.firestore {
  match /databases/{database}/documents {

    // Access is restricted to admin-provisioned accounts: the signed-in
    // email must have a matching doc in `allowedUsers/{email}` (managed by
    // the admin in the Firebase console). Email verification is not used —
    // there is no self-serve signup, and a stranger who self-registers via
    // the Auth API has no allowlist doc, so every rule below denies them.
    // rules' get()/exists() are privileged reads, so the allowlist collection
    // itself can stay locked to clients (see the allowedUsers match block).
    function isAllowed() {
      return request.auth != null
        && exists(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower()));
    }

    // Admin = an allowed user whose allowedUsers/{email} doc has `admin: true`
    // (set by the site admin in the Firebase console). Only admins may CREATE
    // cloud projects; members can still read/update/switch the ones they're
    // shared into. get().data.get(key, default) tolerates docs without the field.
    function isAdmin() {
      return isAllowed()
        && get(/databases/$(database)/documents/allowedUsers/$(request.auth.token.email.lower())).data.get('admin', false) == true;
    }

    // Lowercased to match how the client normalizes/stores memberEmails
    // (cloud-projects.ts's normEmail) — a raw-case mismatch here would
    // make Firestore reject the whole query, not just deny matching docs.
    function email() {
      return request.auth.token.email.lower();
    }

    // No `data.memberEmails is list` type-guard here on purpose: Firestore
    // can't statically prove an `array-contains` LIST query satisfies a rule
    // that type-checks the field first, and rejects the whole query with
    // permission-denied (confirmed via the Firestore emulator) — memberEmails
    // is always written as an array by the client, so the guard is
    // redundant for reads. Writes keep the stricter check (see
    // memberEmailsIncludeOwner) since single-document writes aren't subject
    // to this list-query limitation.
    function isMember(data) {
      return email() in data.memberEmails;
    }

    function memberEmailsIncludeOwner(data) {
      return data.ownerEmail is string
        && data.memberEmails is list
        && data.ownerEmail in data.memberEmails;
    }

    // Admin-managed allowlist: one doc per permitted account, id = the
    // lowercased email. Created/edited by the admin in the Firebase console
    // (client writes are denied). A user may read only their own doc, which
    // the app's sign-in gate uses to decide access — so nobody can enumerate
    // who else is allowed. (isAllowed()'s exists() is a privileged rules read
    // and works regardless of these client rules.)
    match /allowedUsers/{email} {
      allow read: if request.auth != null && request.auth.token.email.lower() == email;
      allow write: if false;
    }

    match /projects/{projectId} {
      allow read: if isAllowed() && isMember(resource.data);

      // Creation is admin-only (members can still be shared into existing
      // projects and read/update them).
      allow create: if isAdmin()
        && request.resource.data.ownerEmail == email()
        && memberEmailsIncludeOwner(request.resource.data)
        && isMember(request.resource.data);

      allow update: if isAllowed()
        && isMember(resource.data)
        && memberEmailsIncludeOwner(request.resource.data)
        // Ownership can't be handed off by a plain update (no UI for it yet).
        && request.resource.data.ownerEmail == resource.data.ownerEmail
        // Phase 14: only the owner may change the member list itself — any
        // member could otherwise add/remove others via the same field.
        && (request.resource.data.memberEmails == resource.data.memberEmails
            || email() == resource.data.ownerEmail);

      // Owner-only: any member deleting the shared project (plus every
      // teammate's files) is too destructive to leave open.
      allow delete: if isAllowed() && email() == resource.data.ownerEmail;

      match /files/{fileId} {
        allow read, write: if isAllowed()
          && isMember(get(/databases/$(database)/documents/projects/$(projectId)).data);
      }

      // Phase 15: saved Compare/Clash result metadata. Firestore rules don't
      // cascade into subcollections, so this needs its own block — without it
      // the default deny made saveResult()'s metadata write and
      // fetchResultMetadata()'s read both fail, so restore never fired.
      match /results/{resultId} {
        allow read, write: if isAllowed()
          && isMember(get(/databases/$(database)/documents/projects/$(projectId)).data);
      }
    }
  }
}
